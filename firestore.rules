rules_version = '2';

// Friend 360 Firestore rules. Anything not allowed here is denied.
//
// users/{uid}                 public profile: any signed-in user can read
// users/{uid}/private/goals    daily goals: only the owner
// users/{uid}/private/settings sharing settings: only the owner (the daily
//                              rules below also consult them)
// users/{uid}/daily/{yyyy-MM-dd} published daily totals: the owner and
//                              their accepted friends read, only the owner writes
// usernames/{username}        {uid} claim that keeps usernames unique
// friendships/{a}_{b}         friend requests and friends, one per pair
// friendCodes/{code}          {uid} claim that keeps friend codes unique
//
// Daily totals are only accepted for what the owner currently shares: a
// write is checked against their saved settings (users/{uid}/private/settings,
// read with get(), which works although clients can't read that document
// when it isn't theirs). Hidden metrics and writes while paused are rejected,
// and a missing or unreadable settings document rejects the write too, so a
// stale session can't republish what another device took down. Each daily
// write evaluates that one get(); a batch of 14 stays under the 20 access
// calls allowed per batched write, so keep FirestoreStatsPublisher.windowDays
// at 20 or less. Deletes need no check (taking data down is always allowed).
// Settings older than this check store pausedUntil as an ISO string; those
// can't be compared, so writes stay rejected until the app converts it to a
// timestamp on its next load. The app creates the default settings document
// (hidden: sleep, screenTime; pausedUntil: null) on the first load, which the
// settings create rule accepts, so a new user can publish without touching
// the privacy screen.
//
// Reads are fenced the same way, but only for pausing: friends can't read
// daily documents while the saved settings are paused (or unreadable), even
// when removing the published days failed. The owner always can. Hiding one
// metric can NOT be fenced on reads: a rule on a list query can't look at the
// documents' keys. The app removes the key right after the change and keeps
// retrying with backoff while that fails (StatsSync), but until it succeeds
// accepted friends can still read the old value. That is the residual risk.
//
// Claims are only accepted together with the matching profile (same
// transaction), so nobody can grab usernames or codes they don't use.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validName(name) {
      return name is string && name.trim().size() > 0 && name.size() <= 30;
    }

    function validAvatar(emoji) {
      return emoji is string && emoji.size() > 0 && emoji.size() <= 16;
    }

    // Same rules as usernameProblem() in lib/models/account.dart.
    function validUsername(name) {
      return name is string
        && name.matches('^[a-z][a-z0-9_.]{2,19}$')
        && !name.matches('.*[.][.].*')
        && !name.matches('.*[.]$');
    }

    // Same names as StatMetric in lib/models/stat_metric.dart.
    function validHidden(hidden) {
      return hidden is list
        && hidden.size() <= 5
        && hidden.hasOnly(['steps', 'sleep', 'workout', 'calories', 'screenTime']);
    }

    // Matches friendshipId() in lib/data/firestore_friends_repository.dart.
    function isPairId(pairId, a, b) {
      return (a < b && pairId == a + '_' + b)
        || (b < a && pairId == b + '_' + a);
    }

    // Same pair id as friendshipId(): the lower uid first.
    function areFriends(a, b) {
      let pairId = a < b ? a + '_' + b : b + '_' + a;
      let path = /databases/$(database)/documents/friendships/$(pairId);
      return exists(path) && get(path).data.status == 'accepted';
    }

    // Day documents are named like dateKey() in lib/models/dates.dart.
    function validDay(day) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // A metric is optional (hidden ones are left out) but never negative or huge.
    function validCount(data, key, max) {
      return !(key in data)
        || (data[key] is int && data[key] >= 0 && data[key] <= max);
    }

    // The owner's saved sharing settings (see SharingSettings). Fails when the
    // document is missing, which rejects the write.
    function savedSettings(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/private/settings).data;
    }

    // Paused until a time still ahead, or a pause that can't be compared
    // (older ISO-string format): not allowed to publish.
    function notPaused(settings) {
      return settings.pausedUntil == null
        || (settings.pausedUntil is timestamp && settings.pausedUntil <= request.time);
    }

    // A metric key may only be in the document if the owner doesn't hide it.
    function mayShare(settings, data, key) {
      return !(key in data) || !(key in settings.hidden);
    }

    // Whether a daily document may be published under the owner's [settings].
    function mayPublish(settings, data) {
      return notPaused(settings)
        && mayShare(settings, data, 'steps')
        && mayShare(settings, data, 'sleep')
        && mayShare(settings, data, 'workout')
        && mayShare(settings, data, 'calories')
        && mayShare(settings, data, 'screenTime');
    }

    // Same alphabet as generateFriendCode() in lib/models/account.dart.
    function validFriendCode(code) {
      return code is string && code.matches('^[A-HJKMNP-Z2-9]{6}$');
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'username', 'avatarEmoji', 'friendCode', 'createdAt'])
        && validName(request.resource.data.displayName)
        && validAvatar(request.resource.data.avatarEmoji)
        && validUsername(request.resource.data.username)
        && validFriendCode(request.resource.data.friendCode)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == uid;

      // Username and friend code can't change (they're claimed elsewhere).
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'avatarEmoji'])
        && validName(request.resource.data.displayName)
        && validAvatar(request.resource.data.avatarEmoji);

      allow delete: if isMe(uid);

      match /private/goals {
        allow read, write: if isMe(uid);
      }

      // Same shape as SharingSettings.toJson() in lib/models/sharing_settings.dart.
      match /private/settings {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['hidden', 'pausedUntil'])
          && request.resource.data.keys().hasAll(['hidden', 'pausedUntil'])
          && validHidden(request.resource.data.hidden)
          && (request.resource.data.pausedUntil == null
              || (request.resource.data.pausedUntil is string
                  && request.resource.data.pausedUntil.size() <= 40)
              || request.resource.data.pausedUntil is timestamp);
      }

      // Limits match FirestoreStatsPublisher.maxValues. Keys are StatMetric names.
      match /daily/{day} {
        // Queries on users/{uid}/daily are allowed to the same people. Friends
        // are also locked out while the saved settings are paused.
        allow read: if isMe(uid)
          || (signedIn() && areFriends(request.auth.uid, uid) && notPaused(savedSettings(uid)));

        allow create, update: if isMe(uid)
          && validDay(day)
          && request.resource.data.keys().hasOnly(
               ['date', 'steps', 'sleep', 'workout', 'calories', 'screenTime', 'updatedAt'])
          && request.resource.data.keys().hasAll(['date', 'updatedAt'])
          && request.resource.data.date == day
          && request.resource.data.updatedAt == request.time
          && validCount(request.resource.data, 'steps', 200000)
          && validCount(request.resource.data, 'sleep', 1440)
          && validCount(request.resource.data, 'workout', 1440)
          && validCount(request.resource.data, 'calories', 20000)
          && validCount(request.resource.data, 'screenTime', 1440)
          && mayPublish(savedSettings(uid), request.resource.data);

        allow delete: if isMe(uid);
      }
    }

    match /usernames/{username} {
      allow read: if signedIn();

      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // One document per pair of people, id "<lower uid>_<higher uid>", so a
    // pair can't have two requests. Firebase uids never contain "_".
    // Declining, cancelling and unfriending all delete the document.
    match /friendships/{pairId} {
      // A single get works even before the document exists (so the app
      // can check for an existing request), but only for your own pairs.
      allow get: if signedIn() && request.auth.uid in pairId.split('_');
      // Queries must be limited to friendships you're part of.
      allow list: if signedIn() && request.auth.uid in resource.data.users;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['requesterId', 'addresseeId', 'users', 'status', 'createdAt'])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.addresseeId is string
        && request.resource.data.addresseeId != request.auth.uid
        && request.resource.data.users ==
             [request.resource.data.requesterId, request.resource.data.addresseeId]
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && isPairId(pairId, request.auth.uid, request.resource.data.addresseeId)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.addresseeId));

      // Only the person who was asked can accept, and only that changes.
      allow update: if signedIn()
        && resource.data.addresseeId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'respondedAt'])
        && request.resource.data.respondedAt == request.time;

      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    match /friendCodes/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && validFriendCode(code)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.friendCode == code;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
